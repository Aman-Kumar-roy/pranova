# ==============================================================================
# PRANOVA HEALTHCARE COORDINATION PLATFORM - LOCAL ENVIRONMENT
# Format: Bagisto / Laravel Standard Key-Value Pairs
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT
# ------------------------------------------------------------------------------
APP_NAME=PRANOVA
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:5000
APP_TIMEZONE=Asia/Kolkata
PORT=5000

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (BAGISTO STYLE)
# ------------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=pranova_db
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_SCHEMA=public
DB_SSLMODE=prefer

# Computed Prisma Connection URL
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/pranova_db?schema=public&pgbouncer=true&connection_limit=1"

# ------------------------------------------------------------------------------
# 3. DEFAULT ADMIN CREDENTIALS (USED BY SEEDER / INITIAL SETUP)
# ------------------------------------------------------------------------------
ADMIN_FIRST_NAME=Super
ADMIN_LAST_NAME=Admin
ADMIN_EMAIL=admin@pranova.com
ADMIN_PASSWORD=Admin@123456
ADMIN_PHONE=+919876500000
ADMIN_DEPARTMENT=Operations

# ------------------------------------------------------------------------------
# 4. API & AUTHENTICATION (JWT SECRETS)
# ------------------------------------------------------------------------------
JWT_SECRET=pranova_super_secret_jwt_access_token_key_2026_healthcare
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=pranova_super_secret_jwt_refresh_token_key_2026_healthcare
JWT_REFRESH_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 5. CLIENT URLS & CORS ORIGINS
# ------------------------------------------------------------------------------
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
ADMIN_WEB_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 6. SWAGGER / API EXPLORER
# ------------------------------------------------------------------------------
ENABLE_SWAGGER=true
